# ============================================================
# BlindJourney – Variables de entorno
# Copia este archivo a .env y rellena tus valores reales.
# ¡NUNCA subas el .env a Git!
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Base de datos MySQL ───────────────────────────────────────
# Asegúrate de crear la BD: CREATE DATABASE blindjourney CHARACTER SET utf8mb4;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blindjourney
DB_USER=root
DB_PASSWORD=tu_password_aqui

# ── JWT ───────────────────────────────────────────────────────
# Genera una clave larga y aleatoria: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_secreta_muy_larga_y_aleatoria
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Nodemailer) ────────────────────────────────────────
# Para Gmail: activa "Contraseñas de aplicación" en tu cuenta Google
# Para desarrollo sin email real: deja estas variables vacías (imprime en consola)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_FROM="BlindJourney" <noreply@blindjourney.com>

# ── Stripe ────────────────────────────────────────────────────
# Obtén tus claves en https://dashboard.stripe.com/apikeys
# Usa claves de TEST (sk_test_...) para desarrollo
STRIPE_SECRET_KEY=sk_test_pon_aqui_tu_clave_secreta_de_stripe
# Webhook secret: obtenlo en el dashboard de Stripe > Webhooks > tu endpoint
STRIPE_WEBHOOK_SECRET=whsec_pon_aqui_tu_webhook_secret

# ── Google Gemini ─────────────────────────────────────────────
# Obtén tu API key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_pon_aqui_tu_gemini_api_key
