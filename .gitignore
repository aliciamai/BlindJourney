# ============================================================
# BlindJourney – .gitignore
# ¡NUNCA subas .env ni node_modules a Git!
# ============================================================

# ── Entorno (contiene secretos) ───────────────────────────
.env
.env.local
.env.*.local

# ── Dependencias de Node ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Cobertura de tests ─────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ───────────────────────────────────────────────────
logs/
*.log

# ── Archivos de sistema operativo ─────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editores e IDEs ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user

# ── Build / distribución ───────────────────────────────────
dist/
build/
.next/
out/

# ── Certificados y claves privadas ────────────────────────
*.pem
*.key
*.cert

# ── Uploads temporales ────────────────────────────────────
uploads/
tmp/

# ── Documentación (PDFs y assets locales) ─────────────────
documentation/

# ── Claude Code (configuración local del desarrollador) ───
.claude/
